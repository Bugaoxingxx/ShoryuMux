<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shoryumux.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BINDIR__/shoryumuxd</string>
        <string>__CONFIG__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__LOGDIR__/shoryumuxd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/shoryumuxd.err.log</string>
</dict>
</plist>
